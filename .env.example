# ---- Exposure -------------------------------------------------------------
# 127.0.0.1 = this machine only (no auth required). Any other value requires
# SOC_AUTH_PASSWORD, otherwise the app refuses to start.
SOC_BIND_ADDR=127.0.0.1
SOC_PORT=8090
SOC_AUTH_USER=analyst
SOC_AUTH_PASSWORD=
# Container user; match the owner of ./customers and ./data
SOC_UID=1000
SOC_GID=1000

# ---- Limits ---------------------------------------------------------------
SOC_MAX_UPLOAD_BYTES=5242880
SOC_MAX_LOG_CHARS=2000000

# ---- LLM ------------------------------------------------------------------
# none | claude_pro | anthropic | ollama
# claude_pro = your Claude Pro/Max subscription through the Claude Code CLI (no API key needed)
LLM_PROVIDER=none
# Global kill switch for providers that send data off this machine.
LLM_ALLOW_EXTERNAL=false
LLM_TIMEOUT_SECONDS=240
LLM_MAX_LOG_CHARS=60000
LLM_MAX_CONTEXT_CHARS=120000

# anthropic: Claude API (pay-per-use API key; not needed with claude_pro)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# claude_pro: Claude Code CLI logged in with your Pro account, reached via bridge/claude_bridge.py on the host
CLAUDE_BRIDGE_URL=http://host.docker.internal:8765
CLAUDE_BRIDGE_TOKEN=
CLAUDE_CLI_MODEL=

# ollama: local model
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_IS_LOCAL=true

# ---- Schema catalog -----------------------------------------------------------
# Allow "Pull from Microsoft" to fetch public table docs from learn.microsoft.com
# (no customer data is sent). Set false for fully offline use.
CATALOG_FETCH_ENABLED=true
