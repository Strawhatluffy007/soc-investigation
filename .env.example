# ---- Exposure -------------------------------------------------------------
# 127.0.0.1 = this machine only (no auth required). Any other value requires
# SOC_AUTH_PASSWORD, otherwise the app refuses to start.
SOC_BIND_ADDR=127.0.0.1
SOC_PORT=8090
SOC_AUTH_USER=analyst
SOC_AUTH_PASSWORD=
# Container user; match the owner of ./customers and ./data
SOC_UID=1000
SOC_GID=1000

# ---- Limits ---------------------------------------------------------------
SOC_MAX_UPLOAD_BYTES=5242880
SOC_MAX_LOG_CHARS=2000000

# ---- LLM ------------------------------------------------------------------
# Starting provider; change it any time in the web UI (LLM settings).
# none | claude_pro | chatgpt | anthropic | openai | gemini | openai_compatible | ollama
# claude_pro / chatgpt = your subscription through the Claude Code / Codex CLI (no API key needed)
LLM_PROVIDER=none
# Global kill switch for providers that send data off this machine.
LLM_ALLOW_EXTERNAL=false
LLM_TIMEOUT_SECONDS=240
LLM_MAX_LOG_CHARS=60000
LLM_MAX_CONTEXT_CHARS=120000

# anthropic: Claude API (pay-per-use API key; not needed with claude_pro)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# API keys for other providers. Optional: you can also paste keys in LLM settings
# (stored in data/secrets/llm-keys.json, mode 0600). A key set here wins.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=

# claude_pro: Claude Code CLI logged in with your Pro account, reached via bridge/claude_bridge.py on the host
CLAUDE_BRIDGE_URL=http://host.docker.internal:8765
CLAUDE_BRIDGE_TOKEN=
CLAUDE_CLI_MODEL=

# ollama: local model
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_IS_LOCAL=true
# Context window in tokens. Ollama's default is small and silently cuts long prompts.
# Larger needs more VRAM; with a 6 GB GPU use 8192-12288 and lower LLM_MAX_*_CHARS (docs/windows.md).
OLLAMA_NUM_CTX=8192
# Reasoning models (qwen3, deepseek-r1): leave false so the reply is plain JSON.
OLLAMA_THINK=false

# ---- Schema catalog -----------------------------------------------------------
# Allow "Pull from Microsoft" to fetch public table docs from learn.microsoft.com
# (no customer data is sent). Set false for fully offline use.
CATALOG_FETCH_ENABLED=true
